# Cloudflare Workers static-assets headers (https://developers.cloudflare.com/workers/static-assets/headers/)
# Paintings and hashed bundles are content-addressed -> cache for a year.
/paintings/*
  Cache-Control: public, max-age=31536000, immutable
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/headshot.jpg
  Cache-Control: public, max-age=604800
/papers/*
  Cache-Control: public, max-age=86400

# The paper PDFs compete with their own HTML pages in search results, and the
# HTML page is the better landing page. Keep the PDFs reachable, unindexed.
/papers/*.pdf
  X-Robots-Tag: noindex, nofollow
  Cache-Control: public, max-age=86400

# Plain-text mirrors for AI crawlers that do not run JavaScript. Served as
# markdown and kept out of the search index so they never compete with the
# HTML pages they mirror.
/papers/*.md
  Content-Type: text/markdown; charset=utf-8
  X-Robots-Tag: noindex
  Cache-Control: public, max-age=86400
